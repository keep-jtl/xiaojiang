# ==========================================================
# 小财通 .gitignore —— 告诉 Git 哪些文件/文件夹不要纳入存档
# 作用：保护敏感信息、排除缓存和临时文件、避免大文件进入仓库
# ==========================================================

# ---------- 敏感信息（任何情况下都不要提交） ----------
.env
.env.*
*.key
*.pem
config.local.*
secrets.*

# ---------- Python（本项目数据层使用 Python） ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# ---------- 数据库与用户数据（本地生成，不进仓库） ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/user_data/
# 数据库备份目录：整目录忽略（含 .db / .zip / 任何将来新增的备份格式）
data/backup/

# ---------- 日志 ----------
*.log
logs/

# ---------- 打包产物（将来发布时生成） ----------
build/
dist/
*.spec.bak

# ---------- 编辑器 / IDE 配置文件 ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 操作系统生成的杂项文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 节点依赖（如将来原型用到构建工具） ----------
node_modules/

# ---------- Claude Code 本地会话文件 ----------
.claude/
