# ==========================================================
# 小财通 .gitignore —— 告诉 Git 哪些文件/文件夹不要纳入存档
# 作用：保护敏感信息、排除缓存和临时文件、避免大文件进入仓库
# ==========================================================

# ---------- 敏感信息（任何情况下都不要提交） ----------
.env
.env.*
*.key
*.pem
config.local.*
secrets.*

# ---------- Python（本项目数据层使用 Python） ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# ---------- 数据库与用户数据（本地生成，不进仓库） ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/user_data/
# 数据库备份目录：整目录忽略（含 .db / .zip / 任何将来新增的备份格式）
data/backup/
# 运行时数据缓存与验证基线（本地联网生成，不进仓库）
data/*.json

# ---------- 日志 ----------
*.log
logs/

# ---------- 打包产物（将来发布时生成） ----------
build/
dist/
*.spec.bak

# ---------- 编辑器 / IDE 配置文件 ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 操作系统生成的杂项文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 节点依赖与 Web 构建产物 ----------
node_modules/
www/

# ---------- Android 构建 / 签名（密钥绝不进 Git） ----------
*.jks
*.keystore
keystore.properties
android/.gradle/
android/local.properties
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/build/
*.apk
*.aab

# ---------- Release 资产（在仓库外/Release 附件，不作为源码提交） ----------
release/

# ---------- Claude Code 本地会话文件 ----------
.claude/

# ---------- docs 开发过程稿（mock 与设计稿大图不进仓库；正式 .md 文档保留） ----------
docs/banner_bg.jpg
docs/bk_mock_*
docs/bk_v3_*.png
